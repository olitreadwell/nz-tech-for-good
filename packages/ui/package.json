{
  "name": "@olitreadwell/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "echo ok",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@olitreadwell/config-tailwind": "*",
    "@olitreadwell/config-typescript": "*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
