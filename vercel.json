{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/out",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "development": true,
      "**": false
    }
  },
  "github": {
    "autoJobCancelation": true
  }
}
