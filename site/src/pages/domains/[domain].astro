---
import Layout from "../../components/Layout.astro";
import EntryCard from "../../components/EntryCard.astro";
import CircleGraph from "../../components/CircleGraph.astro";
import { url } from "../../lib/url";
import {
  domains,
  entriesByDomain,
  internalEdges,
  domainDescription,
  type Domain,
} from "../../lib/data";

export function getStaticPaths() {
  return domains.map((d) => ({
    params: { domain: d.slug },
    props: { domain: d },
  }));
}

interface Props {
  domain: Domain;
}
const { domain } = Astro.props;
const items = entriesByDomain(domain.key);
const iedges = internalEdges(domain.key);
const description = domainDescription(domain.key);

// Only build a close-up graph when there are real internal connections.
const graphNodes = iedges.length
  ? items.map((e) => ({ id: e.name, label: e.name, count: 1 }))
  : [];
const graphEdges = iedges.map(([a, b]) => ({ a, b }));

const noun = items.length === 1 ? "organisation" : "organisations";
---

<Layout
  title={domain.label}
  active="domains"
  description={`${items.length} ${noun} in the ${domain.label} domain of the NZ Tech-for-Good directory.`}
>
  <p class="crumbs">
    <a href={url("/domains/")}>← All domains</a>
  </p>
  <div class="prose">
    <h1>{domain.label}</h1>
    {description && <p>{description}</p>}
    <p class="lead">{items.length} {noun} in this domain.</p>
  </div>

  {
    items.length > 5 && (
      <details class="toc" style="margin:1rem 0;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);">
        <summary style="cursor:pointer;font-weight:600;">Jump to an organisation ({items.length})</summary>
        <ul style="columns:2;column-gap:2rem;margin-top:0.5rem;padding-left:1.2rem;">
          {items.map((entry) => (
            <li style="break-inside:avoid;">
              <a href={url(`/entry/${entry.slug}/`)}>{entry.name}</a>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    graphEdges.length > 0 && (
      <section aria-labelledby="connections-heading">
        <h2 id="connections-heading">How these connect</h2>
        <p>
          Lines show recorded relationships between organisations in this
          domain, for example one running on another's data, or sharing a
          network. Only verified connections are shown.
        </p>
        <CircleGraph
          nodes={graphNodes}
          edges={graphEdges}
          title={`Relationship map of organisations in the ${domain.label} domain`}
          size={620}
        />
        <ul>
          {graphEdges.map((e) => (
            <li>
              <strong>{e.a}</strong> ↔ <strong>{e.b}</strong>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2>All {domain.label} organisations</h2>
  <ul class="grid">
    {items.map((entry) => <EntryCard entry={entry} showDomain={false} />)}
  </ul>
</Layout>
