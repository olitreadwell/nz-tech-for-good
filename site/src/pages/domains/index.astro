---
import Layout from "../../components/Layout.astro";
import { url } from "../../lib/url";
import { domains, totalEntries } from "../../lib/data";
---

<Layout
  title="Domains"
  active="domains"
  description="Browse the NZ Tech-for-Good directory by domain — the area of public good each organisation works in."
>
  <div class="prose">
    <h1>Domains</h1>
    <p class="lead">
      The areas of public good these {totalEntries} organisations work in. Pick one
      to see every organisation in it.
    </p>
  </div>

  <ul class="tiles">
    {
      domains.map((d) => (
        <li>
          <a class="tile" href={url(`/domains/${d.slug}/`)}>
            <span class="tile-name">{d.label}</span>
            <span class="tile-count">
              {d.count}
              <span class="visually-hidden">
                {" "}
                organisations
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
