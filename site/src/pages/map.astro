---
import Layout from "../components/Layout.astro";
import { url } from "../lib/url";
import { entries, regions, domains, tags, slugify, domainLabel } from "../lib/data";
import { REGION_COORDS } from "../lib/regions";

// Group entries by region with counts
const regionEntries = new Map<string, typeof entries>();
for (const e of entries) {
  if (!regionEntries.has(e.region)) regionEntries.set(e.region, []);
  regionEntries.get(e.region)!.push(e);
}

// Region markers with lat/lng and count
const markers = regions
  .filter((r) => REGION_COORDS[r.name])
  .map((r) => ({
    name: r.name,
    slug: r.slug,
    count: r.count,
    latlng: REGION_COORDS[r.name],
    entries: regionEntries.get(r.name) || [],
  }));

// Domain color palette
const PALETTE = ["#2563eb","#dc2626","#16a34a","#ca8a04","#9333ea","#0891b2","#e11d48","#65a30d","#d97706","#4f46e5","#0d9488","#b91c1c","#7c3aed","#0284c7","#c026d3","#ea580c","#059669","#db2777","#6366f1","#14b8a6","#be123c","#854d0e","#4338ca","#0e7490","#9d174d","#a16207","#1d4ed8"];
const domainColor = new Map(domains.map((d, i) => [d.key, PALETTE[i % PALETTE.length]]));
---

<Layout
  title="Map"
  active="map"
  description={`Interactive map showing ${entries.length} organisations across ${regions.length} NZ regions.`}
>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <div id="map-container" style="display:flex;gap:0;flex-wrap:wrap;">
    <div id="map" style="flex:1;min-width:280px;height:70vh;min-height:400px;border-radius:var(--radius);overflow:hidden;"></div>
    <div id="map-panel" style="width:320px;padding:0 0 0 1rem;overflow-y:auto;max-height:70vh;">
      <h2 style="margin-top:0;">Regions</h2>
      <div class="field" style="margin-bottom:0.5rem;">
        <input type="search" id="map-search" placeholder="Search entries…" style="width:100%;font:inherit;padding:0.4rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);" />
      </div>
      <div class="field" style="margin-bottom:1rem;">
        <select id="map-domain" style="width:100%;font:inherit;padding:0.4rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);">
          <option value="">All domains</option>
          {domains.map((d) => <option value={d.key}>{d.label} ({d.count})</option>)}
        </select>
      </div>
      <div class="field" style="margin-bottom:0.5rem;">
        <select id="map-region" style="width:100%;font:inherit;padding:0.4rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);">
          <option value="">All regions</option>
          {regions.map((r) => <option value={r.name}>{r.name} ({r.count})</option>)}
        </select>
      </div>
      <div class="field" style="margin-bottom:0.5rem;">
        <select id="map-tag" style="width:100%;font:inherit;padding:0.4rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);">
          <option value="">All tags</option>
          {tags.slice(0, 40).map((t) => <option value={t.name}>{t.name} ({t.count})</option>)}
        </select>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:0.25rem 0.75rem;margin-bottom:0.5rem;font-size:0.85rem;">
        <label style="cursor:pointer;"><input type="checkbox" id="map-contributors" /> Contributors</label>
        <label style="cursor:pointer;"><input type="checkbox" id="map-careers" /> Careers</label>
        <label style="cursor:pointer;"><input type="checkbox" id="map-remote" /> Remote</label>
        <label style="cursor:pointer;"><input type="checkbox" id="map-github" /> GitHub</label>
        <label style="cursor:pointer;"><input type="checkbox" id="map-linkedin" /> LinkedIn</label>
        <label style="cursor:pointer;"><input type="checkbox" id="map-community" /> Community</label>
        <label style="cursor:pointer;"><input type="checkbox" id="map-events" /> Events</label>
      </div>
      <div class="field" style="margin-bottom:1rem;">
        <select id="map-decade" style="width:100%;font:inherit;padding:0.4rem 0.6rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);">
          <option value="">Any founding decade</option>
          <option value="pre-2000">Before 2000</option>
          <option value="2000s">2000–2009</option>
          <option value="2010s">2010–2019</option>
          <option value="2020s">2020+</option>
        </select>
      </div>
      <ul id="map-region-list" style="list-style:none;padding:0;margin:0;">
        {markers.map((m) => (
          <li style="margin-bottom:0.3rem;">
            <button type="button" class="region-btn" data-region={m.name}
              style="font:inherit;border:none;background:none;color:var(--text);cursor:pointer;text-align:left;width:100%;padding:0.3rem 0.5rem;border-radius:var(--radius-sm);font-size:0.9rem;">
              <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--accent);margin-right:0.4rem;"></span>
              {m.name === "national" ? "National" : m.name}
              <span style="color:var(--text-muted);margin-left:0.3rem;">({m.count})</span>
            </button>
          </li>
        ))}
      </ul>
      <div id="map-entries" style="margin-top:1rem;"></div>
    </div>
  </div>

  <style>
    @media (max-width: 768px) {
      #map-container { flex-direction: column; }
      #map-panel { width: 100%; padding: 1rem 0 0 0; max-height: none; }
      #map { height: 50vh; }
    }
    .region-btn:hover { background: var(--surface); }
    .region-btn.active { background: var(--accent); color: white; }
    .region-btn.active span { color: white; }
  </style>
</Layout>

<script>
  // Wait for Leaflet to load
  (function waitForL() {
    if (typeof L === "undefined") { setTimeout(waitForL, 100); return; }
    initMap();
  })();

  function initMap() {
    var map = L.map("map").setView([-40.9, 174.0], 6);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);

    var allMarkers = MARKERS.map(function(m) {
      // Find the most common domain in this region for the color
      var domainCounts = {};
      m.entries.forEach(function(e) { domainCounts[e.domain] = (domainCounts[e.domain] || 0) + 1; });
      var topDomain = Object.keys(domainCounts).sort(function(a,b) { return domainCounts[b] - domainCounts[a]; })[0];
      var color = DOMAIN_COLORS[topDomain] || "#2563eb";
      var radius = Math.max(8, Math.min(30, m.count * 2.5));
      
      var circle = L.circleMarker(m.latlng, {
        radius: radius,
        fillColor: color,
        color: "#fff",
        weight: 2.5,
        fillOpacity: 0.85,
      }).addTo(map);
      circle.bindTooltip(m.name === "national" ? "National" : m.name + " (" + m.count + ")");

      // Popup with top entries
      var topEntries = m.entries.slice(0, 5).map(function(e) {
        return '<a href="/nz-tech-for-good/entry/' + e.slug + '/">' + e.name + '</a> <span style="color:#888;">(' + e.domainLabel + ')</span>';
      }).join('<br/>');
      circle.bindPopup('<strong>' + (m.name === "national" ? "National" : m.name) + ' (' + m.count + ')</strong><br/>' + topEntries + (m.entries.length > 5 ? '<br/><em>+ ' + (m.entries.length - 5) + ' more</em>' : ''));

      circle.on("click", function() { showRegion(m.name); });
      return { circle: circle, name: m.name };
    });

    // Keyboard navigation
    var regionList = MARKERS.map(function(m) { return m.name; }).filter(function(n) { return n !== "national"; });
    var currentIdx = -1;
    document.addEventListener("keydown", function(e) {
      if (e.target.tagName === "INPUT" || e.target.tagName === "SELECT" || e.target.tagName === "TEXTAREA") return;
      if (e.key === "ArrowDown" || e.key === "ArrowRight") {
        e.preventDefault();
        currentIdx = (currentIdx + 1) % regionList.length;
        showRegion(regionList[currentIdx]);
      }
      if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
        e.preventDefault();
        currentIdx = currentIdx <= 0 ? regionList.length - 1 : currentIdx - 1;
        showRegion(regionList[currentIdx]);
      }
    });

    function showRegion(regionName) {
      var btns = document.querySelectorAll(".region-btn");
      btns.forEach(function(b) {
        b.classList.toggle("active", b.dataset.region === regionName);
      });
      var q = document.getElementById("map-search");
      q.value = "";
      var d = document.getElementById("map-domain");
      d.value = "";
      renderEntries(regionName, "", "");
    }

    function renderEntries(region, search, domain) {
      var container = document.getElementById("map-entries");
      var regionMarker = MARKERS.find(function(m) { return m.name === region; });
      if (!regionMarker) { container.innerHTML = "<p>Select a region to see entries.</p>"; return; }
      var filtered = regionMarker.entries;
      if (search) {
        var s = search.toLowerCase();
        filtered = filtered.filter(function(e) {
          return (e.name + " " + e.what + " " + e.tags.join(" ")).toLowerCase().indexOf(s) !== -1;
        });
      }
      if (domain) {
        filtered = filtered.filter(function(e) { return e.domain === domain; });
      }
      if (filtered.length === 0) {
        container.innerHTML = "<p>No entries match.</p>";
        return;
      }
      container.innerHTML = "<h3>" + (region === "national" ? "National" : region) + " (" + filtered.length + ")</h3>" +
        filtered.map(function(e) {
          return '<div style="margin-bottom:0.5rem;padding:0.5rem;border:1px solid var(--border);border-radius:var(--radius-sm);"><a href="/nz-tech-for-good/entry/' + e.slug + '/" style="font-weight:600;">' + e.name + '</a><br/><span style="font-size:0.85rem;color:var(--text-muted);">' + e.domainLabel + '</span></div>';
        }).join("");
    }

    // Region button clicks
    document.querySelectorAll(".region-btn").forEach(function(btn) {
      btn.addEventListener("click", function() {
        showRegion(btn.dataset.region);
      });
    });

    // Search
    document.getElementById("map-search").addEventListener("input", applyAll);

    // Region clicks set the region dropdown
    function showRegion(regionName) {
      document.getElementById("map-region").value = regionName;
      var btns = document.querySelectorAll(".region-btn");
      btns.forEach(function(b) { b.classList.toggle("active", b.dataset.region === regionName); });
      applyAll();
    }

    // Domain filter
    document.getElementById("map-domain").addEventListener("change", applyAll);
    document.getElementById("map-region").addEventListener("change", applyAll);
    document.getElementById("map-tag").addEventListener("change", applyAll);
    document.getElementById("map-decade").addEventListener("change", applyAll);
    ["map-contributors","map-careers","map-remote","map-github","map-linkedin","map-community","map-events"].forEach(function(id) {
      document.getElementById(id).addEventListener("change", applyAll);
    });

    function applyAll() {
      var region = document.getElementById("map-region").value;
      var search = document.getElementById("map-search").value;
      var domain = document.getElementById("map-domain").value;
      var tag = document.getElementById("map-tag").value;
      var decade = document.getElementById("map-decade").value;
      var contributors = document.getElementById("map-contributors").checked;
      var careers = document.getElementById("map-careers").checked;
      var remote = document.getElementById("map-remote").checked;
      var github = document.getElementById("map-github").checked;
      var linkedin = document.getElementById("map-linkedin").checked;
      var community = document.getElementById("map-community").checked;
      var events = document.getElementById("map-events").checked;
      renderAllEntries(region, search, domain, tag, decade, contributors, careers, remote, github, linkedin, community, events);
    }

    function renderAllEntries(region, search, domain, tag, decade, contributors, careers, remote, github, linkedin, community, events) {
      var all = entries;
      if (region) all = all.filter(function(e) { return e.region === region; });
      if (search) {
        var s = search.toLowerCase();
        all = all.filter(function(e) { return (e.name + " " + e.what + " " + e.tags.join(" ")).toLowerCase().indexOf(s) !== -1; });
      }
      if (domain) all = all.filter(function(e) { return e.domain === domain; });
      if (tag) all = all.filter(function(e) { return e.tags.indexOf(tag) !== -1; });
      if (decade) {
        all = all.filter(function(e) {
          var fy = e.founding_year || 0;
          if (decade === "pre-2000") return fy < 2000 && fy > 0;
          if (decade === "2000s") return fy >= 2000 && fy < 2010;
          if (decade === "2010s") return fy >= 2010 && fy < 2020;
          if (decade === "2020s") return fy >= 2020;
        });
      }
      if (contributors) all = all.filter(function(e) { return e.takes_contributors === true; });
      if (careers) all = all.filter(function(e) { return e.careers_url; });
      if (remote) all = all.filter(function(e) { return e.tags.indexOf("remote") !== -1; });
      if (github) all = all.filter(function(e) { return e.github; });
      if (linkedin) all = all.filter(function(e) { return e.linkedin_org; });
      if (community) all = all.filter(function(e) { return e.community_url; });
      if (events) all = all.filter(function(e) { return e.events_url; });

      var container = document.getElementById("map-entries");
      if (all.length === 0) { container.innerHTML = "<p>No entries match.</p>"; return; }
      container.innerHTML = "<h3>" + (region || "All regions") + " (" + all.length + ")</h3>" +
        all.map(function(e) {
          return '<div style="margin-bottom:0.5rem;padding:0.5rem;border:1px solid var(--border);border-radius:var(--radius-sm);"><a href="/nz-tech-for-good/entry/' + e.slug + '/" style="font-weight:600;">' + e.name + '</a><br/><span style="font-size:0.85rem;color:var(--text-muted);">' + e.domainLabel + ' · ' + e.region + '</span></div>';
        }).join("");
    }

    // Show national by default
    showRegion("national");
  }
</script>

<script is:inline define:vars={{ markers: markers.map(m => JSON.stringify(m)), domainColors: JSON.stringify(Object.fromEntries(domainColor)), entriesJSON: JSON.stringify(entries.map(e => ({slug:e.slug,name:e.name,domain:e.domain,domainLabel:e.domainLabel,region:e.region,what:e.what,tags:e.tags,takes_contributors:e.takes_contributors,careers_url:!!e.careers_url,github:!!e.github,linkedin_org:!!e.linkedin_org,community_url:!!e.community_url,events_url:!!e.events_url,founding_year:e.founding_year}))) }}>
  var MARKERS = markers.map(JSON.parse);
  var DOMAIN_COLORS = JSON.parse(domainColors);
  var entries = JSON.parse(entriesJSON);
</script>
