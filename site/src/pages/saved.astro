---
import Layout from "../components/Layout.astro";
import EmptyState from "../components/EmptyState";
import { url } from "../lib/url";
---

<Layout
  title="Saved entries"
  active="saved"
  description="Your saved organisations from the NZ Tech-for-Good directory."
>
  <div class="prose">
    <h1>Saved entries</h1>
    <p class="lead">
      Organisations you have saved while browsing. Saved entries are stored
      in your browser and are private to you.
    </p>
  </div>

  <noscript>
    <p>Saved entries require JavaScript to work. Please enable JavaScript and reload.</p>
  </noscript>

  <div class="js-only">
    <p id="saved-status">Loading saved entries…</p>
    <ul class="grid" id="saved-list"></ul>
    <p class="prose" id="saved-empty" hidden>
      <EmptyState icon="☆" title="No saved entries" description="You have not saved any entries yet. Browse the directory and click ☆ Save on any entry to bookmark it." action={{ label: "Browse directory", href: "/directory/" }} />
    </p>
    <p class="prose" style="margin-top:1rem;">
      <a href={url("/directory/")}>← Back to directory</a>
    </p>
  </div>
</Layout>

<script is:inline>
  (function() {
    var list = document.getElementById("saved-list");
    var status = document.getElementById("saved-status");
    var empty = document.getElementById("saved-empty");
    try {
      var slugs = JSON.parse(localStorage.getItem("saved-entries") || "[]");
    } catch(e) { var slugs = []; }
    if (slugs.length === 0) {
      status.hidden = true;
      empty.hidden = false;
      return;
    }
    status.textContent = "Showing " + slugs.length + " saved " + (slugs.length === 1 ? "entry" : "entries") + ":";
    
    // Build a lookup from the entries data embedded in the page
    var allCards = document.querySelectorAll("[data-entry]");
    if (allCards.length === 0) {
      // On saved page, there are no entry cards pre-rendered.
      // We need to load entries from the API or embed them.
      status.textContent = slugs.length + " saved " + (slugs.length === 1 ? "entry" : "entries") + ". Visit the entry pages to see details:";
      slugs.forEach(function(slug) {
        var li = document.createElement("li");
        var a = document.createElement("a");
        a.href = "/nz-tech-for-good/entry/" + slug + "/";
        a.textContent = slug.replace(/-/g, " ");
        a.style.cssText = "display:block;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);";
        li.appendChild(a);
        list.appendChild(li);
      });
    }
    // Also show unsave all button
    var clearBtn = document.createElement("button");
    clearBtn.textContent = "Clear all saved entries";
    clearBtn.style.cssText = "font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.5rem 0.9rem;cursor:pointer;margin-top:1rem;";
    clearBtn.addEventListener("click", function() {
      localStorage.removeItem("saved-entries");
      location.reload();
    });
    list.parentNode.insertBefore(clearBtn, list.nextSibling);
  })();
</script>
