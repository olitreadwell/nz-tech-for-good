---
import Layout from "../../components/Layout.astro";
import { url } from "../../lib/url";
import { entries, slugify, relatedEntries, type Entry } from "../../lib/data";

export function getStaticPaths() {
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const related = relatedEntries(entry);
const slugFor = (name: string) => entries.find((e) => e.name === name)?.slug;

// "Also in this domain" — other entries in the same domain, excluding current
const sameDomain = entries
  .filter((e) => e.domain === entry.domain && e.slug !== entry.slug)
  .slice(0, 5);
---

<Layout title={entry.name} description={entry.what} breadcrumbs={[
  { label: "Directory", href: url("/directory/") },
  { label: entry.name },
]}>
  <div class="detail-header prose">
    <a class="pill" href={url(`/domains/${slugify(entry.domain)}/`)}
      >{entry.domainLabel}</a
    >
    <h1>{entry.name}</h1>
    <p class="lead">{entry.what}</p>
    <p class="links" style="font-weight:600;">
      <button
        type="button"
        id="copy-link"
        class="js-only"
        style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.3rem 0.7rem;cursor:pointer;font-weight:600;margin-right:0.5rem;"
        title="Copy link to this entry"
      >
        🔗 Copy link
      </button>
      <button type="button" id="share-twitter" class="js-only" title="Share on X (Twitter)" style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.3rem 0.7rem;cursor:pointer;font-weight:600;margin-right:0.5rem;">𝕏 Share</button>
      <a href={`https://github.com/olitreadwell/nz-tech-for-good/edit/main/data/entries/${entry.slug}.yaml`} target="_blank" rel="noopener noreferrer" style="font:inherit;font-size:0.85rem;color:var(--text-muted);">✏ Edit on GitHub</a>
      {
        entry.website && (
          <a href={entry.website} target="_blank" rel="noopener noreferrer">
            Visit website ↗
          </a>
        )
      }
      {
        entry.github && (
          <a href={entry.github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        )
      }
      {
        entry.linkedin_org && (
          <a href={entry.linkedin_org} target="_blank" rel="noopener noreferrer">
            LinkedIn ↗
          </a>
        )
      }
      {
        entry.careers_url && (
          <a href={entry.careers_url} target="_blank" rel="noopener noreferrer">
            Careers / volunteering ↗
          </a>
        )
      }
      {
        entry.community_url && (
          <a href={entry.community_url} target="_blank" rel="noopener noreferrer">
            Join community ↗
          </a>
        )
      }
      {
        entry.events_url && (
          <a href={entry.events_url} target="_blank" rel="noopener noreferrer">
            Events ↗
          </a>
        )
      }
    </p>
  </div>

  <dl class="def-list">
    <dt>Domain</dt>
    <dd>
      <a href={url(`/domains/${slugify(entry.domain)}/`)}>{entry.domainLabel}</a>
    </dd>
    <dt>Region</dt>
    <dd>
      <a href={url(`/regions/${slugify(entry.region)}/`)}>
        {entry.region === "national" ? "National (all of NZ)" : entry.region}
      </a>
    </dd>
    {entry.founding_year && (
      <>
        <dt>Founded</dt>
        <dd>{entry.founding_year}</dd>
      </>
    )}
    {
      entry.tags.length > 0 && (
        <>
          <dt>Tags</dt>
          <dd>
            <ul class="tag-row">
              {entry.tags.map((t) => (
                <li>
                  <span class="pill">{t}</span>
                </li>
              ))}
            </ul>
          </dd>
        </>
      )
    }
    {entry.last_verified && (
      <>
        <dt>Last verified</dt>
        <dd>{entry.last_verified}</dd>
      </>
    )}
  </dl>

  {
    related.length > 0 && (
      <section aria-labelledby="related-heading">
        <h2 id="related-heading">Related organisations</h2>
        <p>Groups connected to {entry.name} in the directory.</p>
        <ul class="tag-row">
          {related.map((r) => {
            const s = slugFor(r.name);
            return (
              <li>
                {s ? (
                  <a class="pill" href={url(`/entry/${s}/`)}>
                    {r.name}
                  </a>
                ) : (
                  <span class="pill">{r.name}</span>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    sameDomain.length > 0 && (
      <section aria-labelledby="also-heading">
        <h2 id="also-heading">Also in {entry.domainLabel}</h2>
        <ul class="tag-row">
          {sameDomain.map((e) => (
            <li>
              <a class="pill" href={url(`/entry/${e.slug}/`)}>{e.name}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    entry.linkedin_people && entry.linkedin_people.length > 0 && (
      <section aria-labelledby="people-heading">
        <h2 id="people-heading">People</h2>
        <ul>
          {entry.linkedin_people.map((p) => (
            <li>
              <a href={p.linkedin_url} target="_blank" rel="noopener noreferrer">
                {p.name}
              </a>{" "}
              · {p.role}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    entry.source && (
      <section aria-labelledby="source-heading" class="prose">
        <h2 id="source-heading">How this was verified</h2>
        <p style="color:var(--text-muted);">{entry.source}</p>
      </section>
    )
  }

  <section aria-labelledby="feedback-heading" class="prose" id="helpful-section">
    <h2 id="feedback-heading">Was this helpful?</h2>
    <div id="helpful-buttons">
      <button type="button" class="helpful-btn" data-value="yes">👍 Yes</button>
      <button type="button" class="helpful-btn" data-value="no">👎 No</button>
    </div>
    <p id="helpful-thanks" hidden style="color:var(--text-muted);">Thanks for the feedback!</p>
  </section>

  <style>
    .helpful-btn {
      font: inherit;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      border-radius: var(--radius-sm);
      padding: 0.4rem 1rem;
      cursor: pointer;
      font-weight: 600;
      margin-right: 0.5rem;
    }
    .helpful-btn:hover { background: var(--accent); color: white; }
  </style>
</Layout>

<script is:inline>
  (function() {
    var btn = document.getElementById("copy-link");
    if (!btn) return;
    btn.addEventListener("click", function() {
      navigator.clipboard.writeText(window.location.href).then(function() {
        btn.textContent = "✓ Copied!";
        setTimeout(function() { btn.textContent = "🔗 Copy link"; }, 2000);
      }).catch(function() {
        btn.textContent = "⚠ Copy failed";
      });
    });

    // Helpful feedback
    var buttons = document.querySelectorAll("#helpful-buttons .helpful-btn");
    var thanks = document.getElementById("helpful-thanks");
    var section = document.getElementById("helpful-section");
    buttons.forEach(function(b) {
      b.addEventListener("click", function() {
        buttons.forEach(function(x) { x.disabled = true; });
        thanks.hidden = false;
        try { localStorage.setItem("helpful-" + window.location.pathname, b.dataset.value); } catch(e) {}
      });
    });
    try {
      if (localStorage.getItem("helpful-" + window.location.pathname)) {
        buttons.forEach(function(x) { x.disabled = true; });
        thanks.hidden = false;
      }
    } catch(e) {}

    // Share on Twitter
    var shareBtn = document.getElementById("share-twitter");
    if (shareBtn) {
      shareBtn.addEventListener("click", function() {
        var text = encodeURIComponent(document.title + " — NZ Tech-for-Good directory");
        var url = encodeURIComponent(window.location.href);
        window.open("https://twitter.com/intent/tweet?text=" + text + "&url=" + url, "_blank", "width=550,height=420");
      });
    }
  })();
</script>
