---
import Layout from "../components/Layout.astro";
import { url } from "../lib/url";
import { tags, entries, totalEntries } from "../lib/data";

const topTags = tags.slice(0, 50);
const maxCount = topTags.length > 0 ? topTags[0].count : 1;
---

<Layout
  title="Tags"
  active="tags"
  description={`Browse ${totalEntries} organisations by tag: ${tags.length} tags covering technologies, causes, and communities.`}
>
  <div class="prose">
    <h1>Tags</h1>
    <p class="lead">
      Browse the directory by tag. Bigger tags have more entries.
    </p>
  </div>

  <ul class="tag-cloud" aria-label="Tag cloud">
    {topTags.map((t) => (
      <li>
        <a
          href={url(`/directory/?tag=${encodeURIComponent(t.name)}`)}
          class="tag"
          style={`font-size:${0.8 + (t.count / maxCount) * 1.4}rem`}
        >
          {t.name} <span class="tag-count">{t.count}</span>
        </a>
      </li>
    ))}
  </ul>

  {tags.length > 50 && (
    <p class="prose" style="margin-top:1rem;">
      … and {tags.length - 50} more tags.{" "}
      <a href={url("/directory/")}>Browse the full directory</a> to explore
      them all.
    </p>
  )}
</Layout>

<style>
  .tag-cloud {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    margin: 2rem 0;
  }
  .tag {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .tag:hover {
    background: var(--accent);
    color: white;
  }
  .tag-count {
    font-size: 0.7em;
    color: var(--text-muted);
    margin-left: 0.2em;
  }
  .tag:hover .tag-count {
    color: inherit;
    opacity: 0.8;
  }
</style>
