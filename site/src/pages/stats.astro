---
import Layout from "../components/Layout.astro";
import { url } from "../lib/url";
import { entries, domains, regions, totalEntries } from "../lib/data";

// Group entries by last_verified month for the trend chart
const byMonth = new Map<string, number>();
for (const e of entries) {
  if (!e.last_verified) continue;
  const month = e.last_verified.slice(0, 7); // YYYY-MM
  byMonth.set(month, (byMonth.get(month) ?? 0) + 1);
}
const months = [...byMonth.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .slice(-12); // last 12 months

const maxMonth = Math.max(...months.map(([, c]) => c), 1);

// Entries with various optional fields filled
const withGithub = entries.filter((e) => e.github).length;
const withLinkedinOrg = entries.filter((e) => e.linkedin_org).length;
const withCareers = entries.filter((e) => e.careers_url).length;
const withCommunity = entries.filter((e) => e.community_url).length;
const withEvents = entries.filter((e) => e.events_url).length;
const withContributors = entries.filter((e) => e.takes_contributors === true).length;
const withRelated = entries.filter((e) => e.related_to.length > 0).length;

// Founding decade distribution
const decades = new Map<string, number>([
  ["Before 2000", 0], ["2000–2009", 0], ["2010–2019", 0], ["2020+", 0], ["Unknown", 0]
]);
for (const e of entries) {
  if (!e.founding_year) { decades.set("Unknown", (decades.get("Unknown") ?? 0) + 1); }
  else if (e.founding_year < 2000) { decades.set("Before 2000", (decades.get("Before 2000") ?? 0) + 1); }
  else if (e.founding_year < 2010) { decades.set("2000–2009", (decades.get("2000–2009") ?? 0) + 1); }
  else if (e.founding_year < 2020) { decades.set("2010–2019", (decades.get("2010–2019") ?? 0) + 1); }
  else { decades.set("2020+", (decades.get("2020+") ?? 0) + 1); }
}
const maxDecade = Math.max(...[...decades.values()], 1);

// Org maturity
const mature = entries.filter((e) => e.founding_year && e.founding_year < 2010).length;
const growing = entries.filter((e) => e.founding_year && e.founding_year >= 2010 && e.founding_year < 2020).length;
const emerging = entries.filter((e) => e.founding_year && e.founding_year >= 2020).length;
---

<Layout
  title="Stats"
  active="stats"
  description={`Key numbers about the ${totalEntries}-entry NZ Tech-for-Good directory: entry growth, domain coverage, and data completeness.`}
>
  <div class="prose">
    <h1>Stats</h1>
    <p class="lead">
      Key numbers about the directory: how it has grown, which domains are
      biggest, and how complete the data is.
    </p>
  </div>

  <ul class="stat-row" aria-label="Directory at a glance">
    <li class="stat">
      <div class="n">{totalEntries}</div>
      <div class="l">organisations</div>
    </li>
    <li class="stat">
      <div class="n">{domains.length}</div>
      <div class="l">domains</div>
    </li>
    <li class="stat">
      <div class="n">{regions.length}</div>
      <div class="l">regions</div>
    </li>
  </ul>

  <section aria-labelledby="growth-heading">
    <h2 id="growth-heading">Entry growth</h2>
    <p>
      Number of entries by month of last verification. Taller bars mean more
      entries were verified or added that month.
    </p>
    <div class="bar-chart" aria-label="Monthly entry count">
      {months.map(([month, count]) => (
        <div class="bar-row">
          <span class="bar-label">{month}</span>
          <span
            class="bar"
            style={`width:${Math.round((count / maxMonth) * 100)}%`}
            aria-label={`${count} entries`}
          ></span>
          <span class="bar-count">{count}</span>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="domains-heading">
    <h2 id="domains-heading">Domains</h2>
    <p>Entries per domain, biggest first.</p>
    <div class="bar-chart" aria-label="Entries per domain">
      {domains.map((d) => (
        <div class="bar-row">
          <span class="bar-label">
            <a href={url(`/domains/${d.slug}/`)}>{d.label}</a>
          </span>
          <span
            class="bar"
            style={`width:${Math.round((d.count / domains[0].count) * 100)}%`}
            aria-label={`${d.count} entries`}
          ></span>
          <span class="bar-count">{d.count}</span>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="regions-heading">
    <h2 id="regions-heading">Regions</h2>
    <p>Entries per region, biggest first.</p>
    <div class="bar-chart" aria-label="Entries per region">
      {regions.map((r) => (
        <div class="bar-row">
          <span class="bar-label">
            <a href={url(`/regions/${r.slug}/`)}>{r.name}</a>
          </span>
          <span
            class="bar"
            style={`width:${Math.round((r.count / regions[0].count) * 100)}%`}
            aria-label={`${r.count} entries`}
          ></span>
          <span class="bar-count">{r.count}</span>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="founding-heading">
    <h2 id="founding-heading">Organisation maturity</h2>
    <p>
      How long organisations have been around, based on verified founding years
      ({totalEntries - (decades.get("Unknown") ?? 0)} of {totalEntries} known).
    </p>
    <ul class="stat-row" aria-label="Maturity breakdown">
      <li class="stat">
        <div class="n">{mature}</div>
        <div class="l">Established (pre-2010)</div>
      </li>
      <li class="stat">
        <div class="n">{growing}</div>
        <div class="l">Growing (2010–2019)</div>
      </li>
      <li class="stat">
        <div class="n">{emerging}</div>
        <div class="l">Emerging (2020+)</div>
      </li>
    </ul>
    <div class="bar-chart" aria-label="Founding decade distribution">
      {[...decades.entries()].map(([decade, count]) => (
        <div class="bar-row">
          <span class="bar-label">{decade}</span>
          <span class="bar" style={`width:${Math.round((count / maxDecade) * 100)}%`} aria-label={`${count} entries`}></span>
          <span class="bar-count">{count}</span>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="completeness-heading" class="prose">
    <h2 id="completeness-heading">Data completeness</h2>
    <p>
      How many of the {totalEntries} entries have each optional field filled
      in. Fields left blank mean the value could not be verified — all data
      is checked against a live source before it is added.
    </p>
    <table>
      <thead>
        <tr><th>Field</th><th>Filled</th><th>Missing</th></tr>
      </thead>
      <tbody>
        <tr><td>GitHub</td><td>{withGithub}</td><td>{totalEntries - withGithub}</td></tr>
        <tr><td>LinkedIn (org)</td><td>{withLinkedinOrg}</td><td>{totalEntries - withLinkedinOrg}</td></tr>
        <tr><td>Careers / volunteering URL</td><td>{withCareers}</td><td>{totalEntries - withCareers}</td></tr>
        <tr><td>Community URL</td><td>{withCommunity}</td><td>{totalEntries - withCommunity}</td></tr>
        <tr><td>Events URL</td><td>{withEvents}</td><td>{totalEntries - withEvents}</td></tr>
        <tr><td>Takes contributors</td><td>{withContributors}</td><td>{totalEntries - withContributors}</td></tr>
        <tr><td>Related entries</td><td>{withRelated}</td><td>{totalEntries - withRelated}</td></tr>
      </tbody>
    </table>
  </section>
</Layout>

<style>
  .bar-chart {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1rem 0 2rem;
  }
  .bar-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bar-label {
    width: 140px;
    flex-shrink: 0;
    font-size: 0.85rem;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bar {
    height: 1.2rem;
    background: var(--accent, #2563eb);
    border-radius: var(--radius-sm, 4px);
    min-width: 2px;
    flex-shrink: 0;
  }
  .bar-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    min-width: 2rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  th {
    font-weight: 600;
  }
</style>
