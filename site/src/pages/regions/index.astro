---
import Layout from "../../components/Layout.astro";
import { url } from "../../lib/url";
import { regions, totalEntries } from "../../lib/data";

// "national" first (it is the largest and a special case), then by count.
const ordered = [...regions].sort((a, b) => {
  if (a.name === "national") return -1;
  if (b.name === "national") return 1;
  return b.count - a.count || a.name.localeCompare(b.name);
});
---

<Layout
  title="Regions"
  active="regions"
  description="Browse the NZ Tech-for-Good directory by region across Aotearoa New Zealand."
>
  <div class="prose">
    <h1>Regions</h1>
    <p class="lead">
      Where these {totalEntries} organisations are based. Many work
      <em>nationally</em>; others are rooted in a particular place.
    </p>
  </div>

  <ul class="tiles">
    {
      ordered.map((r) => (
        <li>
          <a class="tile" href={url(`/regions/${r.slug}/`)}>
            <span class="tile-name">
              {r.name === "national" ? "National (all of NZ)" : r.name}
            </span>
            <span class="tile-count">
              {r.count}
              <span class="visually-hidden"> organisations</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
