---
import Layout from "../components/Layout.astro";
import { url } from "../lib/url";
---

<Layout title="Page not found" description="That page could not be found.">
  <div class="prose">
    <h1>Page not found</h1>
    <p class="lead">Sorry — that page does not exist here.</p>
    <p>
      <a class="button" href={url("/")}>Go to the home page</a>
      <a class="button secondary" href={url("/directory/")}>Browse the directory</a>
    </p>
  </div>
</Layout>
