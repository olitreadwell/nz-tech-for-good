---
import Layout from "../components/Layout.astro";
import { url } from "../lib/url";
import { totalEntries, domains, regions, recentEntries } from "../lib/data";
import EntryCard from "../components/EntryCard";

const topDomains = domains.slice(0, 8);
const newest = recentEntries.slice(0, 5);
---

<Layout title="NZ Tech-for-Good" active="home">
  <section style="padding:2rem 0 1.5rem;text-align:center;">
    <h1 style="font-size:2.2rem;font-weight:800;letter-spacing:-0.02em;margin:0 0 0.75rem;line-height:1.2;">
      Aotearoa New Zealand<br/>tech for public good
    </h1>
    <p style="font-size:1.1rem;color:var(--text-muted);max-width:36rem;margin:0 auto 1.5rem;line-height:1.5;">
      A living directory of {totalEntries} organisations, projects, and networks
      using technology for public benefit — open data, civic tech, climate,
      accessibility, Māori data sovereignty, and more.
    </p>
    <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;margin-bottom:1.5rem;">
      <a class="button" href={url("/directory/")} style="font-size:1rem;padding:0.7rem 1.5rem;">
        Browse {totalEntries} organisations →
      </a>
      <a class="button secondary" href={url("/get-involved/")} style="font-size:1rem;padding:0.7rem 1.5rem;">
        Get involved
      </a>
    </div>
    <div style="display:flex;gap:2rem;justify-content:center;flex-wrap:wrap;">
      <div style="text-align:center;">
        <div style="font-size:1.8rem;font-weight:800;color:var(--accent);">{totalEntries}</div>
        <div style="font-size:0.85rem;color:var(--text-muted);">organisations</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:1.8rem;font-weight:800;color:var(--accent);">{domains.length}</div>
        <div style="font-size:0.85rem;color:var(--text-muted);">domains</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:1.8rem;font-weight:800;color:var(--accent);">{regions.length}</div>
        <div style="font-size:0.85rem;color:var(--text-muted);">regions</div>
      </div>
    </div>
  </section>

  <section aria-labelledby="start-heading" class="js-only" id="start-here" style="background:var(--surface);border:2px solid var(--accent);border-radius:var(--radius);padding:1.25rem;margin:1.5rem 0;">
    <h2 id="start-heading" style="margin-top:0;">👋 New to NZ tech-for-good?</h2>
    <p style="margin:0.5rem 0 1rem;">This directory lists {totalEntries} organisations using technology for public good across Aotearoa. Here is how to get started:</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0.75rem;">
      <a href={url("/directory/")} style="display:block;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);">
        <strong>🔍 Browse the directory</strong><br/>
        <span style="font-size:0.85rem;color:var(--text-muted);">All {totalEntries} organisations, filterable by domain, region, tag, and more.</span>
      </a>
      <a href={url("/domains/")} style="display:block;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);">
        <strong>📂 Explore by domain</strong><br/>
        <span style="font-size:0.85rem;color:var(--text-muted);">{domains.length} areas from open data to climate tech, each with a short explainer.</span>
      </a>
      <a href={url("/get-involved/")} style="display:block;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);">
        <strong>🤝 Get involved</strong><br/>
        <span style="font-size:0.85rem;color:var(--text-muted);">Find communities, events, volunteer opportunities, and how to contribute.</span>
      </a>
      <a href={url("/stats/")} style="display:block;padding:0.75rem;border:1px solid var(--border);border-radius:var(--radius-sm);text-decoration:none;color:var(--text);">
        <strong>📊 See the numbers</strong><br/>
        <span style="font-size:0.85rem;color:var(--text-muted);">Entry growth, domain distribution, data completeness, and more.</span>
      </a>
    </div>
    <p style="margin:0.75rem 0 0;font-size:0.85rem;">
      <button type="button" id="hide-start" style="font:inherit;border:none;background:none;color:var(--text-muted);cursor:pointer;text-decoration:underline;">Hide this section</button>
    </p>
  </section>

  <section aria-labelledby="domains-heading">
    <h2 id="domains-heading">Explore by domain</h2>
    <p>The areas of public good these groups work in. Biggest first.</p>
    <ul class="tiles">
      {
        topDomains.map((d) => (
          <li>
            <a class="tile" href={url(`/domains/${d.slug}/`)}>
              <span class="tile-name">{d.label}</span>
              <span class="tile-count">{d.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p>
      <a href={url("/domains/")}>See all {domains.length} domains →</a>
    </p>
  </section>

  <section aria-labelledby="recent-heading">
    <h2 id="recent-heading">Recently added or updated</h2>
    <ul class="grid">
      {newest.map((entry) => <EntryCard entry={entry} />)}
    </ul>
    <p>
      <a href={url("/directory/")}>Browse all {totalEntries} organisations →</a>
    </p>
  </section>

  <section aria-labelledby="how-heading" class="prose">
    <h2 id="how-heading">How this directory works</h2>
    <p>
      The directory is built from open data files, one per organisation. Each
      is verified against a live source before it is added: if a fact cannot
      be confirmed, the field is left blank rather than guessed. The data is
      shared under a
      <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license"
        >Creative Commons BY-SA&nbsp;4.0</a
      > licence, so you can reuse it with credit.
    </p>
    <p>
      Know a group that should be listed, or spotted something out of date?
      <a href="https://github.com/olitreadwell/nz-tech-for-good"
        >Suggest a change or add an organisation on GitHub</a
      >. No coding is needed to suggest one.
    </p>
  </section>
</Layout>

<script is:inline>
  // Hide start-here section
  (function() {
    var section = document.getElementById("start-here");
    var btn = document.getElementById("hide-start");
    if (!section || !btn) return;
    if (localStorage.getItem("hide-start-here")) section.hidden = true;
    btn.addEventListener("click", function() {
      section.hidden = true;
      localStorage.setItem("hide-start-here", "1");
    });
  })();
</script>
