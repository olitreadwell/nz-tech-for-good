---
import Layout from "../components/Layout.astro";
import { url } from "../lib/url";
import { entries, domains } from "../lib/data";

const communities = entries.filter((e) => e.community_url);
const events = entries.filter((e) => e.events_url);
const volunteering = entries.filter(
  (e) => e.careers_url || e.takes_contributors === true
);
---

<Layout
  title="Get Involved"
  active="get-involved"
  description="New to NZ tech for good? Here's how to join a community, find an event, volunteer, or add your first entry."
>
  <div class="prose">
    <h1>Get Involved</h1>
    <p class="lead">
      This directory lists organisations. This page is about what to do next:
      who to talk to, where to show up, and how to help.
    </p>
  </div>

  <section aria-labelledby="communities-heading">
    <h2 id="communities-heading">Join a community</h2>
    {
      communities.length > 0 ? (
        <>
          <p>
            Real, active NZ groups where you can meet people already working
            in this space.
          </p>
          <ul>
            {communities.map((e) => (
              <li>
                <a href={url(`/entry/${e.slug}/`)}>{e.name}</a>: {e.what}{" "}
                <a href={e.community_url} rel="noopener">
                  Join ↗
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p>
          None listed yet. Know an active NZ tech-for-good Slack, Discord, or
          community group? See{" "}
          <a
            href="https://github.com/olitreadwell/nz-tech-for-good/issues/new?template=add-entry.yml"
          >
            add it
          </a>
          .
        </p>
      )
    }
  </section>

  <section aria-labelledby="events-heading">
    <h2 id="events-heading">Find an event</h2>
    {
      events.length > 0 ? (
        <>
          <p>Meetups and events run by groups in the directory.</p>
          <ul>
            {events.map((e) => (
              <li>
                <a href={url(`/entry/${e.slug}/`)}>{e.name}</a>:{" "}
                <a href={e.events_url} rel="noopener">
                  Upcoming events ↗
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p>None listed yet.</p>
      )
    }
  </section>

  <section aria-labelledby="volunteer-heading">
    <h2 id="volunteer-heading">Volunteer or work with someone</h2>
    {
      volunteering.length > 0 ? (
        <>
          <p>
            Organisations known to take volunteers or outside contributors,
            or with a careers page on file.
          </p>
          <ul>
            {volunteering.map((e) => (
              <li>
                <a href={url(`/entry/${e.slug}/`)}>{e.name}</a>
                {e.careers_url && (
                  <>
                    {" "}
                    <a href={e.careers_url} rel="noopener">
                      Careers / volunteering ↗
                    </a>
                  </>
                )}
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p>None listed yet.</p>
      )
    }
  </section>

  <section aria-labelledby="learn-heading" class="prose">
    <h2 id="learn-heading">Learn about a domain</h2>
    <p>
      Not sure where you'd fit? Browse the {domains.length} areas this
      directory covers, each with a short explanation of what it means and
      who's working in it.
    </p>
    <p>
      <a class="button" href={url("/domains/")}>Browse domains</a>
    </p>
  </section>

  <section aria-labelledby="contribute-heading" class="prose">
    <h2 id="contribute-heading">Add or fix an entry</h2>
    <p>
      Know a group that should be listed, or spotted something out of date?
      No coding is needed.
    </p>
    <p>
      <a
        class="button"
        href="https://github.com/olitreadwell/nz-tech-for-good/issues/new?template=add-entry.yml"
      >
        Suggest an entry
      </a>
      <a
        class="button secondary"
        href="https://github.com/olitreadwell/nz-tech-for-good/blob/main/CONTRIBUTING.md"
      >
        Read the contributor guide
      </a>
    </p>
  </section>
</Layout>
