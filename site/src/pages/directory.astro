---
import Layout from "../components/Layout.astro";
import EntryCard from "../components/EntryCard.astro";
import { entries, domains, regions, tags, totalEntries } from "../lib/data";
---

<Layout
  title="Directory"
  active="directory"
  description={`All ${totalEntries} organisations in the NZ Tech-for-Good directory. Filter by domain, region, or tag, or search by name.`}
>
  <div class="prose">
    <h1>Directory</h1>
    <p class="lead">
      All {totalEntries} organisations. Filter by domain, region, or tag, or search
      by name.
    </p>
  </div>

  <form class="filters" role="search" aria-label="Filter organisations">
    <div class="field">
      <label for="q">Search by name, description, or tag</label>
      <input
        type="search"
        id="q"
        name="q"
        autocomplete="off"
        placeholder="e.g. open data, accessibility, Wellington…"
      />
    </div>
    <div class="row">
      <div class="field">
        <label for="f-domain">Domain</label>
        <select id="f-domain" name="domain">
          <option value="">All domains</option>
          {
            domains.map((d) => (
              <option value={d.key}>
                {d.label} ({d.count})
              </option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="f-region">Region</label>
        <select id="f-region" name="region">
          <option value="">All regions</option>
          {
            regions.map((r) => (
              <option value={r.name}>
                {r.name} ({r.count})
              </option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="f-tag">Tag</label>
        <select id="f-tag" name="tag">
          <option value="">All tags</option>
          {
            tags.map((t) => (
              <option value={t.name}>
                {t.name} ({t.count})
              </option>
            ))
          }
        </select>
      </div>
    </div>
    <div class="js-only">
      <button
        type="button"
        id="clear-filters"
        style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.5rem 0.9rem;cursor:pointer;font-weight:600;"
        >Clear filters</button
      >
    </div>
  </form>

  <p class="filter-status" id="result-count" aria-live="polite" role="status">
    Showing all {totalEntries} organisations.
  </p>
  <p class="no-js-note filter-status">
    Filtering and search need JavaScript. Without it, every organisation is
    listed below, and you can browse by
    <a href={import.meta.env.BASE_URL + "domains/"}>domain</a> or
    <a href={import.meta.env.BASE_URL + "regions/"}>region</a> instead.
  </p>

  <ul class="grid" id="entry-list">
    {entries.map((entry) => <EntryCard entry={entry} />)}
  </ul>

  <p class="filter-status js-only" id="no-results" hidden>
    No organisations match those filters. Try removing one.
  </p>
</Layout>

<script is:inline>
  (function () {
    var q = document.getElementById("q");
    var domainSel = document.getElementById("f-domain");
    var regionSel = document.getElementById("f-region");
    var tagSel = document.getElementById("f-tag");
    var status = document.getElementById("result-count");
    var noResults = document.getElementById("no-results");
    var clearBtn = document.getElementById("clear-filters");
    var cards = Array.prototype.slice.call(
      document.querySelectorAll("[data-entry]")
    );
    var total = cards.length;

    function apply() {
      var text = q.value.trim().toLowerCase();
      var dom = domainSel.value;
      var reg = regionSel.value;
      var tag = tagSel.value;
      var shown = 0;

      cards.forEach(function (card) {
        var ok = true;
        if (text && card.getAttribute("data-search").indexOf(text) === -1)
          ok = false;
        if (dom && card.getAttribute("data-domain") !== dom) ok = false;
        if (reg && card.getAttribute("data-region") !== reg) ok = false;
        if (tag) {
          var tags = card.getAttribute("data-tags").split("|");
          if (tags.indexOf(tag) === -1) ok = false;
        }
        card.hidden = !ok;
        if (ok) shown++;
      });

      if (shown === total) {
        status.textContent = "Showing all " + total + " organisations.";
      } else {
        status.textContent =
          "Showing " + shown + " of " + total + " organisations.";
      }
      noResults.hidden = shown !== 0;
    }

    [q, domainSel, regionSel, tagSel].forEach(function (el) {
      el.addEventListener("input", apply);
      el.addEventListener("change", apply);
    });
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        q.value = "";
        domainSel.value = "";
        regionSel.value = "";
        tagSel.value = "";
        apply();
        q.focus();
      });
    }
  })();
</script>
