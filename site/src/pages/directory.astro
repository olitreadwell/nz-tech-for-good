---
import Layout from "../components/Layout.astro";
import EntryCard from "../components/EntryCard";
import { entries, domains, regions, tags, totalEntries } from "../lib/data";
---

<Layout
  title="Directory"
  active="directory"
  description={`All ${totalEntries} organisations in the NZ Tech-for-Good directory. Filter by domain, region, or tag, or search by name.`}
>
  <div class="prose">
    <h1>Directory</h1>
    <p class="lead">
      All {totalEntries} organisations. Filter by domain, region, or tag, or search
      by name.
    </p>
    <p>
      Missing one? <a
        href="https://github.com/olitreadwell/nz-tech-for-good/issues/new?template=add-entry.yml"
        >Suggest an entry</a
      >. No coding needed.
      <a
        class="button secondary"
        href="https://raw.githubusercontent.com/olitreadwell/nz-tech-for-good/main/data/exports/entries.csv"
        style="margin-left:0.5rem;font-size:0.85rem;"
        >Export as CSV ↓</a
      >
    </p>
  </div>

  <form class="filters" role="search" aria-label="Filter organisations">
    <div class="field">
      <label for="q">Search by name, description, or tag</label>
      <input
        type="search"
        id="q"
        name="q"
        autocomplete="off"
        placeholder="e.g. open data, accessibility, Wellington…"
      />
    </div>
    <div class="row">
      <div class="field">
        <label for="f-domain">Domain</label>
        <select id="f-domain" name="domain">
          <option value="">All domains</option>
          {
            domains.map((d) => (
              <option value={d.key}>
                {d.label} ({d.count})
              </option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="f-region">Region</label>
        <select id="f-region" name="region">
          <option value="">All regions</option>
          {
            regions.map((r) => (
              <option value={r.name}>
                {r.name} ({r.count})
              </option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="f-tag">Tag</label>
        <select id="f-tag" name="tag">
          <option value="">All tags</option>
          {
            tags.map((t) => (
              <option value={t.name}>
                {t.name} ({t.count})
              </option>
            ))
          }
        </select>
      </div>
    </div>
    <div class="js-only" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-contributors" /> Takes contributors/volunteers <span id="count-contributors" style="color:var(--text-muted);"></span>
      </label>
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-remote" /> Remote-friendly
      </label>
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-github" /> Has GitHub
      </label>
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-linkedin" /> Has LinkedIn
      </label>
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-community" /> Has community (Slack/Discord)
      </label>
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-events" /> Has events/meetups
      </label>
    </div>
    <div class="js-only" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:0.5rem;">
      <label for="f-decade" style="font-size:0.85rem;">Founded:</label>
      <select id="f-decade" style="font:inherit;border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.25rem 0.5rem;background:var(--surface);color:var(--text);">
        <option value="">Any</option>
        <option value="pre-2000">Before 2000</option>
        <option value="2000s">2000–2009</option>
        <option value="2010s">2010–2019</option>
        <option value="2020s">2020+</option>
      </select>
      <label style="font-size:0.85rem;cursor:pointer;display:flex;align-items:center;gap:0.25rem;">
        <input type="checkbox" id="f-remote" /> Remote-friendly
      </label>
      <button
        type="button"
        id="clear-filters"
        style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.5rem 0.9rem;cursor:pointer;font-weight:600;"
        >Clear filters</button
      >
    </div>
  </form>

  <div class="js-only" style="display:flex;gap:0.5rem;align-items:center;margin:0.5rem 0;">
    <label for="sort-by" style="font-size:0.85rem;">Sort:</label>
    <select id="sort-by" style="font:inherit;border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.25rem 0.5rem;background:var(--surface);color:var(--text);">
      <option value="name-asc">Name A–Z</option>
      <option value="name-desc">Name Z–A</option>
      <option value="verified-desc">Recently verified</option>
      <option value="verified-asc">Least recently verified</option>
    </select>
    <button type="button" id="random-entry" style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.25rem 0.7rem;cursor:pointer;font-weight:600;margin-left:auto;">🎲 Random</button>
    <button type="button" id="view-toggle" style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.25rem 0.7rem;cursor:pointer;font-weight:600;" data-view="list">🗺 Map</button>
  </div>

  <div id="map-view" hidden style="height:350px;border-radius:var(--radius);overflow:hidden;margin:0.5rem 0;"></div>

  <p class="filter-status" id="result-count" aria-live="polite" role="status">
    Showing all {totalEntries} organisations.
  </p>
  <p class="no-js-note filter-status">
    Filtering and search need JavaScript. Without it, every organisation is
    listed below, and you can browse by
    <a href={import.meta.env.BASE_URL + "domains/"}>domain</a> or
    <a href={import.meta.env.BASE_URL + "regions/"}>region</a> instead.
  </p>

  <h2 class="visually-hidden">Organisations</h2>
  <ul class="grid" id="entry-list">
    {entries.map((entry) => <EntryCard entry={entry} />)}
  </ul>

  <p class="filter-status js-only" id="no-results" hidden>
    No organisations match those filters. Try removing one.
  </p>

  <div class="js-only" id="pagination" style="display:flex;gap:0.5rem;justify-content:center;align-items:center;margin:1.5rem 0;">
    <button type="button" id="prev-page" style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.4rem 0.9rem;cursor:pointer;font-weight:600;" disabled>← Previous</button>
    <span id="page-info" style="font-size:0.85rem;color:var(--text-muted);"></span>
    <button type="button" id="next-page" style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.4rem 0.9rem;cursor:pointer;font-weight:600;">Next →</button>
  </div>
</Layout>

<script is:inline>
  (function () {
    var q = document.getElementById("q");
    var domainSel = document.getElementById("f-domain");
    var regionSel = document.getElementById("f-region");
    var tagSel = document.getElementById("f-tag");
    var contributorsCb = document.getElementById("f-contributors");
    var careersCb = document.getElementById("f-careers");
    var decadeSel = document.getElementById("f-decade");
    var remoteCb = document.getElementById("f-remote");
    var githubCb = document.getElementById("f-github");
    var linkedinCb = document.getElementById("f-linkedin");
    var communityCb = document.getElementById("f-community");
    var eventsCb = document.getElementById("f-events");
    var status = document.getElementById("result-count");
    var noResults = document.getElementById("no-results");
    var clearBtn = document.getElementById("clear-filters");
    var cards = Array.prototype.slice.call(
      document.querySelectorAll("[data-entry]")
    );
    var total = cards.length;

    function readURL() {
      var p = new URLSearchParams(window.location.search);
      return { q: p.get("q") || "", domain: p.get("domain") || "", region: p.get("region") || "", tag: p.get("tag") || "" };
    }

    function syncURL() {
      var p = new URLSearchParams();
      if (q.value) p.set("q", q.value);
      if (domainSel.value) p.set("domain", domainSel.value);
      if (regionSel.value) p.set("region", regionSel.value);
      if (tagSel.value) p.set("tag", tagSel.value);
      var s = p.toString();
      var url = window.location.pathname + (s ? "?" + s : "");
      history.replaceState(null, "", url);
    }

    function apply() {
      var text = q.value.trim().toLowerCase();
      var dom = domainSel.value;
      var reg = regionSel.value;
      var tag = tagSel.value;
      var shown = 0;

      cards.forEach(function (card) {
        var ok = true;
        if (text && card.getAttribute("data-search").indexOf(text) === -1)
          ok = false;
        if (dom && card.getAttribute("data-domain") !== dom) ok = false;
        if (reg && card.getAttribute("data-region") !== reg) ok = false;
        if (tag) {
          var tags = card.getAttribute("data-tags").split("|");
          if (tags.indexOf(tag) === -1) ok = false;
        }
        if (contributorsCb.checked && card.getAttribute("data-contributors") !== "true") ok = false;
        if (careersCb.checked && card.getAttribute("data-careers") !== "true") ok = false;
        var decade = decadeSel.value;
        if (decade) {
          var fy = parseInt(card.getAttribute("data-founded")) || 0;
          if (decade === "pre-2000" && (fy >= 2000 || fy === 0)) ok = false;
          if (decade === "2000s" && (fy < 2000 || fy >= 2010)) ok = false;
          if (decade === "2010s" && (fy < 2010 || fy >= 2020)) ok = false;
          if (decade === "2020s" && fy < 2020) ok = false;
        }
        if (remoteCb.checked && card.getAttribute("data-tags").indexOf("remote") === -1) ok = false;
        if (githubCb.checked && card.getAttribute("data-github") !== "true") ok = false;
        if (linkedinCb.checked && card.getAttribute("data-linkedin") !== "true") ok = false;
        if (communityCb.checked && card.getAttribute("data-community") !== "true") ok = false;
        if (eventsCb.checked && card.getAttribute("data-events") !== "true") ok = false;
        card.hidden = !ok;
        if (ok) shown++;
      });

      if (shown === total) {
        status.textContent = "Showing all " + total + " organisations.";
      } else {
        status.textContent =
          "Showing " + shown + " of " + total + " organisations.";
      }
      noResults.hidden = shown !== 0;

      // Update filter counts
      var countContributors = document.getElementById("count-contributors");
      var countCareers = document.getElementById("count-careers");
      if (countContributors) {
        var c = cards.filter(function(c) { return c.getAttribute("data-contributors") === "true"; }).length;
        countContributors.textContent = "(" + c + ")";
      }
      if (countCareers) {
        var c2 = cards.filter(function(c) { return c.getAttribute("data-careers") === "true"; }).length;
        countCareers.textContent = "(" + c2 + ")";
      }
      if (shown === 0) {
        noResults.innerHTML = 'No organisations match those filters. Try <a href="javascript:void(0)" id="clear-suggest">clearing all filters</a> or <a href="' + (window.location.origin + '/nz-tech-for-good/domains/') + '">browsing by domain</a>.';
        var clearSuggest = document.getElementById("clear-suggest");
        if (clearSuggest) {
          clearSuggest.addEventListener("click", function() {
            q.value = "";
            domainSel.value = "";
            regionSel.value = "";
            tagSel.value = "";
            apply();
            q.focus();
          });
        }
      }
      syncURL();
    }

    // Init from URL params on load
    (function() {
      var u = readURL();
      if (u.q) q.value = u.q;
      if (u.domain) domainSel.value = u.domain;
      if (u.region) regionSel.value = u.region;
      if (u.tag) tagSel.value = u.tag;
      apply();
    })();

    [q, domainSel, regionSel, tagSel].forEach(function (el) {
      el.addEventListener("input", apply);
      el.addEventListener("change", apply);
    });
    [contributorsCb, careersCb, decadeSel, remoteCb, githubCb, linkedinCb, communityCb, eventsCb].forEach(function(cb) {
      cb.addEventListener("change", apply);
    });
    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        q.value = "";
        domainSel.value = "";
        regionSel.value = "";
        tagSel.value = "";
        contributorsCb.checked = false;
        careersCb.checked = false;
        decadeSel.value = "";
        remoteCb.checked = false;
        githubCb.checked = false;
        linkedinCb.checked = false;
        communityCb.checked = false;
        eventsCb.checked = false;
        apply();
        q.focus();
      });
    }

    // Keyboard shortcut: press / to focus search
    document.addEventListener("keydown", function (e) {
      if (e.key === "/" && document.activeElement !== q && document.activeElement?.tagName !== "INPUT" && document.activeElement?.tagName !== "TEXTAREA") {
        e.preventDefault();
        q.focus();
        q.select();
      }
    });

    // Sort
    var sortBy = document.getElementById("sort-by");
    var entryList = document.getElementById("entry-list");
    sortBy.addEventListener("change", function() {
      var val = sortBy.value;
      var sorted = cards.slice().sort(function(a, b) {
        if (val === "name-asc") return a.querySelector("h3 a").textContent.localeCompare(b.querySelector("h3 a").textContent);
        if (val === "name-desc") return b.querySelector("h3 a").textContent.localeCompare(a.querySelector("h3 a").textContent);
        if (val === "verified-desc") return (b.dataset.verified || "").localeCompare(a.dataset.verified || "");
        if (val === "verified-asc") return (a.dataset.verified || "").localeCompare(b.dataset.verified || "");
        return 0;
      });
      sorted.forEach(function(card) { entryList.appendChild(card); });
      cards = Array.prototype.slice.call(document.querySelectorAll("[data-entry]"));
    });

    // Random entry
    var randomBtn = document.getElementById("random-entry");
    randomBtn.addEventListener("click", function() {
      var visible = cards.filter(function(c) { return !c.hidden; });
      if (visible.length === 0) return;
      var pick = visible[Math.floor(Math.random() * visible.length)];
      var link = pick.querySelector("h3 a");
      if (link) window.location.href = link.getAttribute("href");
    });

    // Pagination
    var PAGE_SIZE = 20;
    var currentPage = 1;
    var prevBtn = document.getElementById("prev-page");
    var nextBtn = document.getElementById("next-page");
    var pageInfo = document.getElementById("page-info");

    function updatePagination() {
      var visible = cards.filter(function(c) { return !c.hidden; });
      var totalPages = Math.ceil(visible.length / PAGE_SIZE) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      visible.forEach(function(c, i) {
        var page = Math.floor(i / PAGE_SIZE) + 1;
        c.style.display = page === currentPage ? "" : "none";
      });
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      pageInfo.textContent = "Page " + currentPage + " of " + totalPages;
      document.getElementById("pagination").hidden = visible.length <= PAGE_SIZE;
    }

    prevBtn.addEventListener("click", function() { if (currentPage > 1) { currentPage--; updatePagination(); window.scrollTo(0,0); } });
    nextBtn.addEventListener("click", function() { var totalPages = Math.ceil(cards.filter(function(c) { return !c.hidden; }).length / PAGE_SIZE); if (currentPage < totalPages) { currentPage++; updatePagination(); window.scrollTo(0,0); } });

    // Hook pagination into apply() — store original and wrap
    var originalApply = apply;
    apply = function() { originalApply(); currentPage = 1; updatePagination(); };

    // Map toggle
    var viewToggle = document.getElementById("view-toggle");
    var mapView = document.getElementById("map-view");
    var mapLoaded = false;
    viewToggle.addEventListener("click", function() {
      var isMap = viewToggle.dataset.view === "map";
      if (isMap) {
        viewToggle.textContent = "🗺 Map"; viewToggle.dataset.view = "list";
        mapView.hidden = true;
        entryList.hidden = false;
        document.getElementById("pagination").hidden = false;
        updatePagination();
      } else {
        viewToggle.textContent = "📋 List"; viewToggle.dataset.view = "map";
        entryList.hidden = true;
        document.getElementById("pagination").hidden = true;
        mapView.hidden = false;
        if (!mapLoaded) { loadMap(); mapLoaded = true; }
      }
    });

    function loadMap() {
      var script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.onload = initDirMap;
      document.head.appendChild(script);
      var link = document.createElement("link");
      link.rel = "stylesheet"; link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      document.head.appendChild(link);
    }
    function initDirMap() {
      var map = L.map("map-view").setView([-40.9, 174.0], 6);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: '&copy; OSM', maxZoom: 18 }).addTo(map);
    }
  })();
</script>
