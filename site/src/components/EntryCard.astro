---
import type { Entry } from "../lib/data";
import { slugify } from "../lib/data";
import { url } from "../lib/url";

interface Props {
  entry: Entry;
  /** Show the domain as a pill (hidden on domain pages where it is redundant). */
  showDomain?: boolean;
}
const { entry, showDomain = true } = Astro.props;

// Days since last verification
const daysAgo = entry.last_verified
  ? Math.floor((Date.now() - new Date(entry.last_verified).getTime()) / 86400000)
  : null;
const freshness =
  daysAgo === null ? null
  : daysAgo <= 7 ? "Verified this week"
  : daysAgo <= 30 ? `Verified ${daysAgo} days ago`
  : daysAgo <= 90 ? `Verified ${Math.round(daysAgo / 7)} weeks ago`
  : `Verified ${Math.round(daysAgo / 30)} months ago`;

const searchBlob = [
  entry.name,
  entry.what,
  entry.region,
  entry.domainLabel,
  entry.tags.join(" "),
]
  .join(" ")
  .toLowerCase();
---

<li
  class="card"
  data-entry
  data-domain={entry.domain}
  data-region={entry.region}
  data-tags={entry.tags.join("|")}
  data-search={searchBlob}
  data-verified={entry.last_verified || ""}
  data-contributors={entry.takes_contributors === true ? "true" : "false"}
  data-careers={entry.careers_url ? "true" : "false"}
  data-founded={entry.founding_year ? String(entry.founding_year) : ""}
>
  {
    showDomain && (
      <a class="pill domain-flag" href={url(`/domains/${slugify(entry.domain)}/`)}>
        {entry.domainLabel}
      </a>
    )
  }
  <h3>
    <a href={url(`/entry/${entry.slug}/`)}>{entry.name}</a>
  </h3>
  <p class="what">{entry.what}</p>
  <p class="meta">
    <span>📍 {entry.region}</span>
    {entry.founding_year && <span>Est. {entry.founding_year}</span>}
    {entry.takes_contributors && <span style="color:var(--accent);font-weight:600;">Takes contributors</span>}
    {freshness && <span class={daysAgo !== null && daysAgo > 90 ? "stale" : ""}>🕐 {freshness}</span>}
  </p>
  {
    entry.tags.length > 0 && (
      <ul class="tag-row" aria-label="Tags">
        {entry.tags.slice(0, 5).map((t) => (
          <li>
            <span class="pill">{t}</span>
          </li>
        ))}
      </ul>
    )
  }
  <p class="links">
    {
      entry.website && (
        <a href={entry.website} target="_blank" rel="noopener noreferrer">
          Website<span class="visually-hidden"> for {entry.name}</span> ↗
        </a>
      )
    }
    {
      entry.github && (
        <a href={entry.github} target="_blank" rel="noopener noreferrer">
          GitHub<span class="visually-hidden"> for {entry.name}</span> ↗
        </a>
      )
    }
    {
      entry.linkedin_org && (
        <a href={entry.linkedin_org} target="_blank" rel="noopener noreferrer">
          LinkedIn<span class="visually-hidden"> for {entry.name}</span> ↗
        </a>
      )
    }
    {
      entry.community_url && (
        <a href={entry.community_url} target="_blank" rel="noopener noreferrer">
          Join community<span class="visually-hidden"> for {entry.name}</span> ↗
        </a>
      )
    }
    {
      entry.events_url && (
        <a href={entry.events_url} target="_blank" rel="noopener noreferrer">
          Events<span class="visually-hidden"> for {entry.name}</span> ↗
        </a>
      )
    }
  </p>
</li>
