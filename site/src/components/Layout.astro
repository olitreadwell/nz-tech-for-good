---
import "../styles/global.css";
import { url } from "../lib/url";
import BackToTop from "./BackToTop.astro";

interface Props {
  title: string;
  description?: string;
  /** Which top-level nav item is current: home | directory | domains | regions | ecosystem */
  active?: string;
}

const {
  title,
  description = "A directory of Aotearoa New Zealand organisations, projects, and networks using technology for public good.",
  active,
} = Astro.props;

const nav = [
  { key: "directory", label: "Directory", href: url("/directory/") },
  { key: "domains", label: "Domains", href: url("/domains/") },
  { key: "regions", label: "Regions", href: url("/regions/") },
  { key: "ecosystem", label: "Ecosystem", href: url("/ecosystem/") },
  { key: "stats", label: "Stats", href: url("/stats/") },
  { key: "get-involved", label: "Get Involved", href: url("/get-involved/") },
];

const fullTitle =
  title === "NZ Tech-for-Good" ? title : `${title} · NZ Tech-for-Good`;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <!-- Set the theme before paint so there is no flash; falls back to OS setting. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
        document.documentElement.classList.add("has-js");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={url("/")}>
          <span class="mark" aria-hidden="true">◇</span>
          <span>NZ Tech-for-Good</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active === item.key ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                type="button"
                id="theme-toggle"
                class="js-only"
                aria-pressed="false"
                style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text-muted);border-radius:var(--radius-sm);padding:0.4rem 0.7rem;cursor:pointer;font-weight:600;"
              >
                <span aria-hidden="true">◐</span>
                <span class="visually-hidden">Toggle light or dark theme</span>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p style="margin:0;">
          Community-maintained directory. Data licensed
          <a
            href="https://creativecommons.org/licenses/by-sa/4.0/"
            rel="license">CC&nbsp;BY-SA&nbsp;4.0</a
          >. Every entry is verified against a live source.
        </p>
        <p style="margin:0;">
          <a href="https://github.com/olitreadwell/nz-tech-for-good"
            >Source & how to contribute on GitHub</a
          >
        </p>
      </div>
    </footer>

    <BackToTop />

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function current() {
          return (
            document.documentElement.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light")
          );
        }
        function sync() {
          btn.setAttribute("aria-pressed", current() === "dark" ? "true" : "false");
        }
        sync();
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>
