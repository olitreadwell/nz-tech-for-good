---
import "../styles/global.css";
import "../styles/print.css";
import { url } from "../lib/url";
import BackToTop from "./BackToTop.astro";

interface Props {
  title: string;
  description?: string;
  /** Which top-level nav item is current: home | directory | domains | regions | ecosystem | tags | stats | get-involved */
  active?: string;
  /** Optional breadcrumb trail: [{label, href}] */
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = "A directory of Aotearoa New Zealand organisations, projects, and networks using technology for public good.",
  active,
  breadcrumbs,
} = Astro.props;

const nav = [
  { key: "directory", label: "Browse", href: url("/directory/") },
  { key: "map", label: "Map", href: url("/map/") },
  { key: "stats", label: "Stats", href: url("/stats/") },
  { key: "get-involved", label: "Get Involved", href: url("/get-involved/") },
  { key: "saved", label: "Saved", href: url("/saved/") },
];

const fullTitle =
  title === "NZ Tech-for-Good" ? title : `${title} · NZ Tech-for-Good`;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="NZ Tech-for-Good" href={url("/feed.xml")} />
    <link rel="search" type="application/opensearchdescription+xml" title="NZ Tech-for-Good" href={url("/opensearch.xml")} />
    <link rel="manifest" href={url("/manifest.json")} />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register(new URL("/nz-tech-for-good/sw.js", window.location.origin));
      }
      // Offline/online banner
      var offlineBanner = document.getElementById("offline-banner");
      function updateOnline() {
        offlineBanner.hidden = navigator.onLine;
      }
      window.addEventListener("online", updateOnline);
      window.addEventListener("offline", updateOnline);
      updateOnline();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <!-- Set the theme before paint so there is no flash; falls back to OS setting. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
        document.documentElement.classList.add("has-js");
      })();
    </script>
  </head>
  <body>
    <div id="scroll-progress" style="position:fixed;top:0;left:0;height:3px;background:var(--accent,#2563eb);z-index:1000;width:0;"></div>
    <div id="offline-banner" hidden style="background:#f59e0b;color:#000;text-align:center;padding:0.5rem;font-weight:600;font-size:0.9rem;">You are offline. Some features may be limited.</div>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header" role="banner">
      <div class="bar">
        <a class="brand" href={url("/")}>
          <span class="mark" aria-hidden="true">◇</span>
          <span>NZ Tech-for-Good</span>
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="js-only"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
          style="display:none;font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--radius-sm);padding:0.4rem 0.7rem;cursor:pointer;font-weight:600;font-size:1.2rem;"
        >
          ☰
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active === item.key ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                type="button"
                id="theme-toggle"
                class="js-only"
                aria-pressed="false"
                style="font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text-muted);border-radius:var(--radius-sm);padding:0.4rem 0.7rem;cursor:pointer;font-weight:600;"
              >
                <span aria-hidden="true">◐</span>
                <span class="visually-hidden">Toggle light or dark theme</span>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {breadcrumbs.map((crumb, i) => (
              <li>
                {i > 0 && <span aria-hidden="true" class="crumb-sep">/</span>}
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="main" role="main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="inner">
        <p style="margin:0;">
          Community-maintained directory. Data licensed
          <a
            href="https://creativecommons.org/licenses/by-sa/4.0/"
            target="_blank" rel="license noopener noreferrer">CC&nbsp;BY-SA&nbsp;4.0</a
          >. Every entry is verified against a live source.
        </p>
        <p style="margin:0;">
          <a href="https://github.com/olitreadwell/nz-tech-for-good"
            target="_blank" rel="noopener noreferrer"
            >Source & how to contribute on GitHub</a
          >
        </p>
        <p style="margin:0;font-size:0.8rem;color:var(--text-muted);">
          Updated: {new Date().toISOString().slice(0, 10)} · <span lang="mi">Aotearoa</span> ·
          <select id="lang-switcher" aria-label="Language" style="font:inherit;font-size:0.8rem;border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.1rem 0.3rem;background:var(--surface);color:var(--text-muted);cursor:pointer;">
            <option value="en-NZ" selected>English</option>
            <option value="mi">Te Reo Māori</option>
          </select>
        </p>
      </div>
    </footer>

    <BackToTop />

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function current() {
          return (
            document.documentElement.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light")
          );
        }
        function sync() {
          btn.setAttribute("aria-pressed", current() === "dark" ? "true" : "false");
        }
        sync();
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          sync();
        });

        // Mobile nav toggle
        var menuToggle = document.getElementById("menu-toggle");
        var siteNav = document.getElementById("site-nav");
        if (menuToggle && siteNav) {
          menuToggle.addEventListener("click", function () {
            var expanded = menuToggle.getAttribute("aria-expanded") === "true";
            menuToggle.setAttribute("aria-expanded", String(!expanded));
            siteNav.classList.toggle("open", !expanded);
          });
        }

        // Language switcher
        var langSwitcher = document.getElementById("lang-switcher");
        if (langSwitcher) {
          langSwitcher.addEventListener("change", function() {
            document.documentElement.setAttribute("lang", langSwitcher.value);
            try { localStorage.setItem("lang", langSwitcher.value); } catch(e) {}
          });
          // Restore saved preference
          try {
            var saved = localStorage.getItem("lang");
            if (saved) { langSwitcher.value = saved; document.documentElement.setAttribute("lang", saved); }
          } catch(e) {}
        }
      })();
    </script>

    <script is:inline>
      // Scroll progress bar
      (function() {
        var bar = document.getElementById("scroll-progress");
        if (!bar) return;
        window.addEventListener("scroll", function() {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = h > 0 ? Math.round((window.scrollY / h) * 100) + "%" : "0";
        });
      })();
    </script>

    <style>
      @media (max-width: 768px) {
        #menu-toggle { display: inline-block !important; }
        #site-nav { display: none; }
        #site-nav.open { display: block; }
        #site-nav ul {
          flex-direction: column;
          gap: 0.5rem;
          padding: 0.5rem 0;
        }
        .bar { flex-wrap: wrap; }
      }
    </style>
  </body>
</html>
