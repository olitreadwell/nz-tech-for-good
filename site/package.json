{
  "name": "nz-tech-for-good-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static GitHub Pages site for the NZ Tech-for-Good directory, generated from data/entries/*.yaml.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:smoke": "bddgen && playwright test --grep @smoke",
    "test:a11y": "bddgen && playwright test --grep @a11y",
    "test:e2e:ui": "bddgen && playwright test --ui"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.13.0",
    "js-yaml": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright-bdd": "^9.2.0",
    "vitest": "^4.1.10"
  }
}
