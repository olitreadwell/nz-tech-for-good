[codespell]
skip = .git,node_modules,.next,dist,coverage,playwright-report,test-results,package-lock.json,pnpm-lock.yaml,docs/contributing,.codespellrc
ignore-words-list = organise,organised,organisation,organisations,modelling,behaviour,licence,programme,defence,optimisation,normalise,colour,afterAll
check-hidden = false
quiet-level = 3
