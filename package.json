{
  "name": "@olitreadwell/nz-tech-for-good",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "ci": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "prepush": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage",
    "prepare": "husky",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "husky": "^9.0.11",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.6"
  }
}
