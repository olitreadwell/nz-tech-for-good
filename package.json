{
  "name": "@olitreadwell/kiwi-tech-for-good",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "npm run type-check",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "perf": "pnpm dlx @lhci/cli@latest autorun",
    "smoke": "bash scripts/smoke.sh",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "pnpm audit",
    "test:setup": "node --test scripts/setup.test.mjs",
    "check": "npm run prepush && npm run build",
    "prepare": "husky 2>/dev/null || true",
    "check:ci": "bash scripts/local-ci.sh",
    "ci": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build",
    "type-check": "turbo type-check",
    "prepush": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "^9.0.11",
    "jsdom": "30.1.2",
    "pino-pretty": "13.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vitest-axe": "0.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.6"
  },
  "dependencies": {},
  "overrides": {
    "postcss": "8.5.25",
    "js-yaml": "4.3.2"
  }
}
